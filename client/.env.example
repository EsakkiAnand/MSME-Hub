# Database (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/msme_hub?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/msme_hub?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-32-character-random-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Institutional Google OAuth (Students & Staff)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
ALLOWED_INSTITUTION_DOMAINS="college.edu,university.ac.in"

# GitHub REST API Token (Tree caching & validation)
GITHUB_PERSONAL_ACCESS_TOKEN="ghp_your_github_token"

# Vercel Blob Storage (Industry PDF Uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token"

# Transactional Emails (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="MSME-Hub <notifications@msme-hub.org>"
